# ---------------------------------------------------------------------------
# Quiz Mania API — environment variables
# Copy this file to `.env` for local development, or set these values in your
# hosting dashboard (Render, Koyeb, Railway, Fly.io, VPS) for production.
# ---------------------------------------------------------------------------

# Local development. Set to False in production.
DJANGO_DEBUG=True

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated hosts. On Render use `.onrender.com`; on Koyeb `.koyeb.app`.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Comma-separated browser origins allowed to call the API.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for preview domains, e.g. https://.*\.vercel\.app
DJANGO_CORS_ALLOWED_ORIGIN_REGEXES=

# Admin/CSRF origins (include the https origin of the frontend if needed).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production database. If omitted, SQLite is used (not durable on PaaS).
# Free Postgres options: https://neon.tech, https://supabase.com
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Public frontend URL, used for metadata/links.
SITE_URL=http://localhost:5173

# Optional: secure cookies/SSL redirect (leave off behind a proxy unless sure).
DJANGO_SECURE_SSL_REDIRECT=False

# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
